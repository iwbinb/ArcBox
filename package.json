{
  "name": "arcbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": "22.23.2", "pnpm": "10.34.5" },
  "scripts": {
    "check": "node scripts/toolchain/check.mjs && tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.demo.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.identity.json && tsc -p tsconfig.orders.json && tsc -p tsconfig.platform.json",
    "test:unit": "node --test --test-reporter=tap scripts/m0/probe-arc.test.mjs tests/toolchain.test.mjs",
    "test:runtime": "vite build && vitest run --config vitest.config.ts",
    "test:bindings": "vitest run --config vitest.bindings.config.ts",
    "test:assets": "pnpm build && node --test --test-reporter=tap tests/assets.integration.test.mjs",
    "test:arc": "node scripts/m0/verify-arc.mjs",
    "test": "pnpm test:unit && pnpm test:runtime && pnpm test:bindings && pnpm test:assets && pnpm test:arc && pnpm test:identity && pnpm test:orders && pnpm test:platform",
    "build": "node scripts/toolchain/build.mjs",
    "build:demo": "vite build && node scripts/m1/prepare-demo.mjs",
    "test:demo": "wrangler types workers/demo/worker-configuration.d.ts --config wrangler.demo.jsonc --include-runtime=false --check && wrangler deploy --config wrangler.demo.jsonc --dry-run --outdir dist/demo && node --test --test-reporter=tap tests/demo.integration.test.mjs",
    "build:contracts": "node scripts/toolchain/compile-contract.mjs",
    "build:arc": "node scripts/m0/compile-arc.mjs",
    "setup:arc": "node scripts/toolchain/setup-arc-foundry.mjs",
    "verify": "node scripts/toolchain/verify.mjs && node scripts/m0/verify-arc.mjs && node scripts/m2/verify-orders.mjs && node scripts/m2/verify-identity.mjs && node scripts/m2/verify-platform.mjs",
    "probe:arc": "node scripts/m0/probe-arc.mjs --network testnet",
    "probe:arc:sdk": "node scripts/m0/probe-arc-sdk.mjs",
    "probe:arc:write": "node scripts/m0/arc-testnet-write.mjs",
    "test:identity": "vitest run --config vitest.identity.config.ts",
    "build:identity": "vite build --mode identity --outDir ../../dist/identity",
    "dev:identity": "wrangler dev --config wrangler.identity.jsonc --ip 127.0.0.1 --port 8789",
    "test:identity:browser": "node scripts/m2/browser-identity.mjs",
    "test:orders": "node scripts/m2/capture-order-receipts.mjs && vitest run --config vitest.orders.config.ts",
    "verify:orders": "node scripts/m2/verify-orders.mjs",
    "test:platform": "vitest run --config vitest.platform.config.ts",
    "verify:platform": "node scripts/m2/verify-platform.mjs",
    "dev:platform": "wrangler dev --config wrangler.platform.jsonc --ip 127.0.0.1 --port 8790"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "@cloudflare/vitest-plugin": "1.2.1",
    "wrangler": "4.136.1",
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/node": "22.20.4",
    "solc": "0.8.37",
    "yaml": "2.9.1",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "viem": "2.56.8",
    "@openzeppelin/contracts": "5.6.1"
  }
}
