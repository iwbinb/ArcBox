{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcbox-m0-b-probe",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-09-21",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  }
}
